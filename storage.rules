rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Deny everything by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Creator-scoped media storage: images, audio recordings, background music, and exported videos
    match /users/{userId}/projects/{projectId}/{mediaType}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && mediaType in ['images', 'audio', 'videos']
        && (
          (mediaType == 'images' && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)')) ||
          (mediaType == 'audio' && request.resource.size <= 25 * 1024 * 1024 && request.resource.contentType.matches('audio/.*')) ||
          (mediaType == 'videos' && request.resource.size <= 150 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm)'))
        );
    }
  }
}
